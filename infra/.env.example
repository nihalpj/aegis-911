# AEGIS-911 — local development environment
#
# Copy to infra/.env to override the compose defaults (docker compose picks up
# infra/.env automatically because it sits next to infra/docker-compose.yml):
#
#   cp infra/.env.example infra/.env
#
# Only the docker-compose interpolation defaults are dev-safe. Anything the
# app itself consumes (DATABASE_URL, KMS key, vendor keys…) must be provided
# explicitly — the values below are placeholders, NOT credentials to trust.

# ── Postgres 16 ─────────────────────────────────────────────────────────────
# Superuser/app user created inside the container on first boot.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
# Database created by infra/postgres/init/01-init.sql (idempotent).
POSTGRES_DB=aegis911
# Host port published by the postgres container.
POSTGRES_PORT=5432
# Connection string used by apps/server (host = localhost from the host
# machine, `postgres` when running inside the compose network).
# DATABASE_URL=postgres://aegis:aegis_dev_password@localhost:5432/aegis911

# ── Redis 7 ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=aegis_dev_password
REDIS_PORT=6379
# Connection string used by apps/server.
# REDIS_URL=redis://:aegis_dev_password@localhost:6379

# ── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_ROOT_USER=aegis
MINIO_ROOT_PASSWORD=aegis_dev_password
MINIO_PORT=9000        # S3 API      → http://localhost:9000
MINIO_CONSOLE_PORT=9001 # Web console → http://localhost:9001
# Bucket auto-created by the one-shot `minio-init` container (mc mb --ignore-existing).
S3_BUCKET=aegis-recordings
S3_REGION=us-east-1
# App-side S3 client config (endpoint is `localhost` from the host,
# `http://minio:9000` from inside the compose network).
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=aegis
# S3_SECRET_ACCESS_KEY=aegis_dev_password

# ── Application ─────────────────────────────────────────────────────────────
# When true, Twilio/AssemblyAI vendors are replaced by in-process mocks so the
# whole call flow runs with zero external accounts. Set false only when doing
# real-number testing (see infra/README.md).
MOCK_VENDORS=true

# 32-byte base64 master key for AES-256-GCM envelope encryption of vendor
# secrets at rest (KMS stand-in for local dev). Generate one with:
#   openssl rand -base64 32
# NEVER reuse a production key here; never commit a real value.
KMS_MASTER_KEY=REPLACE_ME_openssl_rand_base64_32

# Host ports for the optional app tier (`docker compose --profile app up`).
SERVER_PORT=4000
WEB_PORT=5173

# ── Real-vendor credentials (only when MOCK_VENDORS=false) ──────────────────
# Loaded by apps/server from the config-service / environment; listed here so
# local real-number testing has one place to look. Prefer setting these via
# the Settings UI (they get envelope-encrypted) instead of this file.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+15551234567
# ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
